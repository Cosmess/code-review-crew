+using Microsoft.AspNetCore.Mvc;
+
+namespace Shop.Api;
+
+[ApiController]
+[Route("api/files")]
+public sealed class FilesController(IConfiguration configuration) : ControllerBase
+{
+    private readonly string _storageRoot = configuration["Storage:Root"]!;
+
+    [HttpGet("{name}")]
+    public IActionResult Download(string name)
+    {
+        var path = Path.Combine(_storageRoot, name);
+        return PhysicalFile(path, "application/octet-stream");
+    }
+}
