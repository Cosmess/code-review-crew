+namespace Shop.Notifications;
+
+public sealed class WelcomeEmail(IEmailSender sender)
+{
+    public async Task SendAsync(string to, CancellationToken ct)
+    {
+        try
+        {
+            await sender.SendAsync(to, "Bem-vindo!", "Obrigado por se cadastrar.", ct);
+        }
+        catch (Exception)
+        {
+        }
+    }
+}
